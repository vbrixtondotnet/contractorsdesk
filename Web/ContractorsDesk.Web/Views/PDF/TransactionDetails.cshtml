@using ContractorsDesk.Core.Dto
@using ContractorsDesk.WebPortal.Helpers
@using ContractorsDesk.WebPortal.Models

@model TransactionDetailsViewModel
@{
	Layout = null;
	var CompanySettings = (CompanySettingDto)ViewBag.CompanySettings;
	var isOwnerDepositsReport = Model.IsOwnerDepositsReport;
	var transactionDate = Model.TransactionDate ?? DateTime.UtcNow.ToString("MMMM dd, yyyy");
}

<!DOCTYPE html>
<html lang="">

<head>
	<title></title>
	<meta content="summary_large_image" name="twitter:card" />
	<meta content="website" property="og:type" />
	<meta content="" property="og:description" />
	<meta content="https://gdx8f9i99q.preview-beefreedesign.com/ZFyty" property="og:url" />
	<meta content="https://pro-bee-beepro-thumbnail.getbee.io/messages/1331205/1317537/2331702/12227207_large.jpg" property="og:image" />
	<meta content="" property="og:title" />
	<meta content="" name="description" />
	<meta charset="utf-8" />
	<meta content="width=device-width" name="viewport" />
	<style>
		.bee-row,
		.bee-row-content {
			position: relative
		}

		.bee-row-6,
		body {
			background-color: #ffffff
		}

		body {
			color: #000000;
			font-family: Arial, Helvetica, sans-serif
		}

		.bee-row-3 .bee-col-1 .bee-block-1 a,
		.bee-row-3 .bee-col-2 .bee-block-1 a,
		.bee-row-4 .bee-col-1 .bee-block-1 a,
		.bee-row-4 .bee-col-2 .bee-block-1 a,
		a {
			color: #7747FF
		}

		* {
			box-sizing: border-box
		}

		body,
		h3,
		p {
			margin: 0
		}

		.bee-row-content {
			max-width: 1280px;
			margin: 0 auto;
			display: flex
		}

			.bee-row-content .bee-col-w6 {
				flex-basis: 50%
			}

			.bee-row-content .bee-col-w12 {
				flex-basis: 100%
			}

		.bee-icon .bee-icon-label-right a {
			text-decoration: none
		}

		.bee-image {
			overflow: auto
		}

			.bee-image .bee-center {
				margin: 0 auto
			}

		.bee-row-1 .bee-col-1 .bee-block-1 {
			width: 100%
		}

		.bee-row-2 .bee-col-1 .bee-block-1 h3,
		.bee-row-5 .bee-col-1 .bee-block-1 h3 {
			color: #514d5a;
			direction: ltr;
			font-family: Arial, Helvetica, sans-serif;
			font-weight: 700;
			letter-spacing: normal;
			line-height: 120%
		}

		.bee-icon {
			display: inline-block;
			vertical-align: middle
		}

			.bee-icon .bee-content {
				display: flex;
				align-items: center
			}

		.bee-image img {
			display: block;
			width: 100%
		}

		.bee-paragraph {
			overflow-wrap: anywhere
		}

		.bee-table table {
			border-collapse: collapse;
			width: 100%
		}

			.bee-table table tbody,
			.bee-table table thead {
				vertical-align: top
			}

			.bee-table table td,
			.bee-table table th {
				padding: 10px;
				word-break: break-word
			}

		.bee-row-1,
		.bee-row-2,
		.bee-row-3,
		.bee-row-4,
		.bee-row-5 {
			background-repeat: no-repeat
		}

			.bee-row-1 .bee-row-content,
			.bee-row-6 .bee-row-content {
				background-repeat: no-repeat;
				color: #000000
			}

			.bee-row-1 .bee-col-1,
			.bee-row-2 .bee-col-1,
			.bee-row-3 .bee-col-1,
			.bee-row-3 .bee-col-2,
			.bee-row-4 .bee-col-1,
			.bee-row-4 .bee-col-2,
			.bee-row-5 .bee-col-1,
			.bee-row-6 .bee-col-1 {
				padding-bottom: 5px;
				padding-top: 5px
			}

			.bee-row-2 .bee-row-content,
			.bee-row-3 .bee-row-content,
			.bee-row-4 .bee-row-content,
			.bee-row-5 .bee-row-content {
				background-repeat: no-repeat;
				border-radius: 0;
				color: #000000
			}

			.bee-row-2 .bee-col-1 .bee-block-1,
			.bee-row-5 .bee-col-1 .bee-block-1 {
				padding: 10px;
				text-align: center;
				width: 100%
			}

			.bee-row-3 .bee-col-1 .bee-block-1,
			.bee-row-3 .bee-col-2 .bee-block-1,
			.bee-row-4 .bee-col-1 .bee-block-1,
			.bee-row-4 .bee-col-2 .bee-block-1,
			.bee-row-5 .bee-col-1 .bee-block-2 {
				padding: 10px
			}

		.bee-row-6 {
			background-repeat: no-repeat
		}

			.bee-row-6 .bee-col-1 .bee-block-1 {
				color: #1e0e4b;
				font-family: Inter, sans-serif;
				font-size: 15px;
				padding-bottom: 5px;
				padding-top: 5px;
				text-align: center
			}

		.bee-row-2 .bee-col-1 .bee-block-1 h3 {
			font-size: 24px;
			text-align: center
		}

		.bee-row-3 .bee-col-1 .bee-block-1,
		.bee-row-3 .bee-col-2 .bee-block-1,
		.bee-row-4 .bee-col-1 .bee-block-1,
		.bee-row-4 .bee-col-2 .bee-block-1 {
			color: #101112;
			direction: ltr;
			font-size: 16px;
			font-weight: 400;
			letter-spacing: 0;
			line-height: 120%;
			text-align: left
		}

			.bee-row-3 .bee-col-1 .bee-block-1 p:not(:last-child),
			.bee-row-3 .bee-col-2 .bee-block-1 p:not(:last-child),
			.bee-row-4 .bee-col-1 .bee-block-1 p:not(:last-child),
			.bee-row-4 .bee-col-2 .bee-block-1 p:not(:last-child) {
				margin-bottom: 16px
			}

		.bee-row-5 .bee-col-1 .bee-block-1 h3 {
			font-size: 16px;
			text-align: left
		}

		.bee-row-6 .bee-col-1 .bee-block-1 .bee-icon-image {
			padding: 5px 6px 5px 5px
		}

		.bee-row-6 .bee-col-1 .bee-block-1 .bee-icon:not(.bee-icon-first) .bee-content {
			margin-left: 0
		}

		.bee-row-6 .bee-col-1 .bee-block-1 .bee-icon::not(.bee-icon-last) .bee-content {
			margin-right: 0
		}
	</style>
	<style>
		.ps-2{
			padding-left: .5rem !important;
		}

		.ps-10 {
			padding-left: 2.5rem !important;
		}
		.text-center{
			text-align: center;
		}
		.text-right{
			text-align:right;
		}

		td.border-bottom-single {
			border-bottom: 2px solid black !important;
		}

		.table tbody tr:last-child td {
			border-bottom: 3px solid #eff2f5 !important;
		}

			.table tbody tr:last-child td.border-bottom-double {
				border-top: 2px solid black !important;
				border-bottom: 5px double black !important;
			}
	</style>
</head>

<body>
	<div class="bee-page-container">
		<div class="bee-row bee-row-1">
			<div class="bee-row-content">
				<div class="bee-col bee-col-1 bee-col-w12">
					<div class="bee-block bee-block-1 bee-image">
						<img alt="" class="bee-center bee-autowidth" src="@CompanySettings.CompanyLogoUrl" style="max-width:333px;" />
					</div>
				</div>
			</div>
		</div>
		<div class="bee-row bee-row-2">
			<div class="bee-row-content">
				<div class="bee-col bee-col-1 bee-col-w12">
					<div class="bee-block bee-block-1 bee-heading">
						<h3><span class="tinyMce-placeholder">Transaction Detail Report</span> </h3>
						<strong><span class="tinyMce-placeholder">@transactionDate</span> </strong>
					</div>
				</div>
			</div>
		</div>
		<div class="bee-row bee-row-3">
			<div class="bee-row-content">
				<div class="bee-col bee-col-2 bee-col-w6">
					<div class="bee-block bee-block-1 bee-paragraph">
						<p>
							<span style="color: #514d5a;"><strong>Project Name</strong></span>: <span style="color: #7a8085;">@Model.ProjectName</span><br />
						</p>
					</div>
				</div>
				<div style="clear:both">&nbsp;</div>
			</div>
		</div>
		<div class="bee-row bee-row-5">
			<div class="bee-row-content">
				<div class="bee-col bee-col-1 bee-col-w12">
					<div class="bee-block bee-block-2 bee-table">
						<table style="table-layout:fixed;direction:ltr;background-color:transparent;font-family:Arial, Helvetica, sans-serif;font-weight:400;color:#101112;text-align:left;letter-spacing:0px;">
							<thead style="background-color:#f2f2f2;color:#101112;font-size:14px;line-height:120%;text-align:center;">
								@{
									var headerStyle = "border-top:1px solid #dddddd;border-right:1px solid #dddddd;border-bottom:1px solid #dddddd;border-left:1px solid #dddddd;";
									var cellStyle = "border-top:1px solid #dddddd;border-right:1px solid #dddddd;border-bottom:1px solid #dddddd;border-left:1px solid #dddddd;";
									var textRight = "text-align:right;";
									var textCenter = "text-align:center;";
								}
								<tr class="fw-bolder fs-6 text-gray-800 bg-light" style="border:3px solid #eff2f5">
									<th class="ps-2" style="@headerStyle; width:200px;">&nbsp;</th>
									<th class="ps-2" style="@headerStyle;width:100px;">Date</th>
									<th class="text-center" style="@headerStyle;width:75px;">Type</th>
									<th class="text-center" style="@headerStyle;width:100px;">Num</th>
									<th class="text-center" style="@headerStyle;width:125px;">Amount</th>
									<th class="text-center" style="@headerStyle;width:175px;">Payee</th>
									<th class="text-center" style="@headerStyle;width:175px;">Memo/Description</th>
								</tr>
							</thead>
							<tbody style="font-size:16px;line-height:120%;">
								@foreach (var transactionDetails in Model.TransactionDetails)
								{
									<tr>
										<td class="ps-2 py-2 fw-bolder">@(isOwnerDepositsReport ? "Owner Deposits" : transactionDetails.Category)</td>
										<td class="ps-2 py-2">&nbsp;</td>
										<td class="text-center">&nbsp;</td>
										<td class="text-center">&nbsp;</td>
										<td class="text-right">&nbsp;</td>
										<td class="text-center">&nbsp;</td>
										<td class="text-center">&nbsp;</td>
									</tr>
									foreach (var lineItem in transactionDetails.LineItems)
									{
										var textClass = lineItem.Balance < 0 ? "text-danger" : "";
										if (!isOwnerDepositsReport)
										{
											<tr>
												<td class="ps-10 py-2 ">@lineItem.Name</td>
												<td class="ps-2 py-2 ">&nbsp;</td>
												<td class="text-center ">&nbsp;</td>
												<td class="text-center">&nbsp;</td>
												<td class="text-right ">&nbsp;</td>
												<td class="text-center ">&nbsp;</td>
												<td class="text-center">&nbsp;</td>
											</tr>
										}

										foreach (var transaction in lineItem.Transactions)
										{
											var borderBottomClass = transaction == lineItem.Transactions.Last() ? "border-bottom-single" : "";
											<tr>
												<td class="ps-10 py-2 @borderBottomClass">&nbsp</td>
												<td class="ps-2 py-2 text-center @borderBottomClass">@transaction.FormattedDate</td>
												<td class="text-center @borderBottomClass">@transaction.Type</td>
												<td class="text-center @borderBottomClass">@transaction.Num</td>
												<td class="text-right @borderBottomClass">@Html.FormatAsMoney(transaction.Amount)</td>
												<td class="text-center">@transaction.Payee</td>
												<td class="text-center">@transaction.Memo</td>
											</tr>
										}
										<tr>
											<td class="ps-2 py-2 text-right fw-bolder border-bottom-double border-top-single" colspan="4" style="">@(isOwnerDepositsReport ? "TOTAL DEPOSITS" : "COST TOTAL")</td>
											<td class="text-right fw-bolder border-bottom-double border-top-single">@Html.FormatAsMoney(lineItem.Total)</td>
											<td class="text-center">&nbsp;</td>
											<td class="text-center">&nbsp;</td>
										</tr>
										<tr>
											@{
												var amount = isOwnerDepositsReport ? Model.TotalCost : lineItem.RevisedEstimate;
											}
											<td class="ps-2 py-2 text-right fw-bolder border-bottom-double" colspan="4" style="">@(isOwnerDepositsReport ? "TOTAL COST" : "Revised Estimate")</td>
											<td class="text-right fw-bolder border-bottom-double">@Html.FormatAsMoney(amount)</td>
											<td class="text-center">&nbsp;</td>
											<td class="text-center">&nbsp;</td>
										</tr>
										<tr>
											@{
												var balance = isOwnerDepositsReport ? lineItem.Total - Model.TotalCost : lineItem.Balance;
											}
											<td class="ps-2 py-2 text-right fw-bolder border-bottom-double" colspan="4" style="">Net Balance</td>
											<td class="text-right fw-bolder border-bottom-double @textClass">@Html.FormatAsMoney(balance)</td>
											<td class="text-center">&nbsp;</td>
											<td class="text-center">&nbsp;</td>
										</tr>
									}
								}
								@if (!isOwnerDepositsReport)
								{
									<tr>
										<td class="text-right border-bottom-double fs-3 fw-bolder" colspan="4">TOTAL AMOUNT</td>
										<td class="text-right fw-bolder border-bottom-double fs-3">@Html.FormatAsMoney(Model.TransactionDetails.Sum(t => t.TotalAmount))</td>
										<td class="text-center">&nbsp;</td>
										<td class="text-center">&nbsp;</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>

</html>