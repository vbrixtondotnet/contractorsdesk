@using ContractorsDesk.Core.Dto
@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.LoadComponents(new string[]{
	"sticky-actions",
	"sticky-header",
	"tagify-select",
	"autocomplete"
})

@{

	var CompanySettings = (CompanySettingDto)ViewBag.CompanySettings;
	var Permissions = (PermissionViewModel)ViewBag.Permissions;
}
<div class="row mb-2 g-6 g-xl-9">
	<div class="card mb-2 mb-xl-2" id="project-body">
		<div class="card-body ps-4 pt-5 pb-0 loading" id="project-details">
			@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 7, Header = false, CardBody = false })
			<!--begin::Details-->
			<div class="d-flex flex-wrap flex-sm-nowrap mb-2">

				<div class="flex-grow-1">
					<div class="flex-shrink-0 bg-white" style="justify-self:center;">
						<img class="mw-100px mw-lg-250px" src="@CompanySettings.CompanyLogoUrl" alt="image" />
					</div>
					<!--begin::Head-->
					<div class="d-flex justify-content-between align-items-start flex-wrap mb-2 mt-4">
						<!--begin::Details-->
						<div class="d-flex flex-column">
							<!--begin::Status-->
							<div class="d-flex align-items-center mb-1">
								<a href="#" class="text-gray-800 text-hover-primary fs-2 fw-bolder me-3">
									@CompanySettings.CompanyName
								</a>
							</div>
							<!--end::Status-->
							<!--begin::Description-->
							<div class="d-flex flex-wrap fw-bold mb-4 fs-5 text-gray-400">
								@if (!string.IsNullOrWhiteSpace(CompanySettings.Address1))
								{
									@CompanySettings.Address1

									<br />
								}
								@if (!string.IsNullOrWhiteSpace(CompanySettings.Address2))
								{
									@CompanySettings.Address2

									<br />
								}
								@if (!string.IsNullOrWhiteSpace(CompanySettings.City) || !string.IsNullOrWhiteSpace(CompanySettings.State) || !string.IsNullOrWhiteSpace(CompanySettings.Zip))
								{
									var cityStateZip = $"{CompanySettings.City}, {CompanySettings.State} {CompanySettings.Zip}".Trim(' ', ',');
									@cityStateZip

									<br />
								}
								@if (!string.IsNullOrWhiteSpace(CompanySettings.PhoneNumber))
								{
									<text>Phone: @CompanySettings.PhoneNumber<br /></text>
								}

								@if (!string.IsNullOrWhiteSpace(CompanySettings.CompanyEmail))
								{
									<text>Email: @CompanySettings.CompanyEmail</text>
								}
							</div>
							<!--end::Description-->
						</div>
						<!--end::Details-->
						<!--begin::Actions-->
						<div class="d-flex mw-lg-500px print-50">
							<div class="row">
								<div class="col-md-12">
									<h2 class="text-gray-800 fs-1 fw-bolder mb-5 justify-self-right"> Project Schedule</h2>
									<div class="row">
										<div class="py-3 justify-content-between align-items-start flex-wrap mb-2 fs-5">
											<div class="">
												<div class="fw-bolder">Project Name: <span class="text-gray-600" id="lblProjectName" data-bookmark-title="true"></span></div>
											</div>
											<div class="">
												<div class="fw-bolder">
													Start Date:
													<span class="text-gray-600" id="lblStartDate"></span>
												</div>
											</div>
											<div class="">
												<div class="fw-bolder">
													Estimated Completion Date:
													<span class="text-gray-600" id="lblEstimatedCompletionDate"></span>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!--end::Actions-->
					</div>

					<div class="row">
						<div class="gap-3 mb-2">
							<div class="justify-self-right">
								<button type="button" class="btn btn-sm btn-bg-primary text-inverse-primary me-1 min-w-lg-100px d-none btn-save-schedule"
										data-status="Draft"
										data-status-toggle="Draft"
										evt-click="saveSchedule">
									<span class="indicator-label">Save as Draft</span>
									<span class="indicator-progress">
										Please wait...
										<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
									</span>
								</button>
								<button type="button" class="btn btn-sm btn-bg-success text-inverse-success me-1 min-w-lg-100px d-none btn-save-schedule"
										data-status="Final"
										data-status-toggle="Draft"
										evt-click="saveSchedule">
									<span class="indicator-label">Save and Finalize</span>
									<span class="indicator-progress">
										Please wait...
										<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
									</span>
								</button>
								<button type="button" class="btn btn-sm btn-bg-primary text-inverse-primary me-1 min-w-lg-100px d-none btn-save-schedule"
										data-status="Final"
										data-status-toggle="Final"
										evt-click="saveSchedule">
									<span class="indicator-label">Save Schedule</span>
									<span class="indicator-progress">
										Please wait...
										<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
									</span>
								</button>
								<a href="javascript:" class="btn btn-sm btn-bg-light text-inverse-light me-1" evt-click="onCancelChanges">Cancel</a>
								<button type="button" class="btn btn-sm btn-bg-secondary text-inverse-secondary me-1 w-150px" evt-click="print" id="btnPrint">
									<span class="indicator-label">Print</span>
									<span class="indicator-progress">
										Please wait...
										<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
									</span>
								</button>
								<a href="javascript:" class="btn btn-sm btn-light-primary me-1 always-enabled" evt-click="onEmailToClientClick">
									<span class="svg-icon svg-icon-muted">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
											<path d="M15.43 8.56949L10.744 15.1395C10.6422 15.282 10.5804 15.4492 10.5651 15.6236C10.5498 15.7981 10.5815 15.9734 10.657 16.1315L13.194 21.4425C13.2737 21.6097 13.3991 21.751 13.5557 21.8499C13.7123 21.9488 13.8938 22.0014 14.079 22.0015H14.117C14.3087 21.9941 14.4941 21.9307 14.6502 21.8191C14.8062 21.7075 14.9261 21.5526 14.995 21.3735L21.933 3.33649C22.0011 3.15918 22.0164 2.96594 21.977 2.78013C21.9376 2.59432 21.8452 2.4239 21.711 2.28949L15.43 8.56949Z" fill="black"></path>
											<path opacity="0.3" d="M20.664 2.06648L2.62602 9.00148C2.44768 9.07085 2.29348 9.19082 2.1824 9.34663C2.07131 9.50244 2.00818 9.68731 2.00074 9.87853C1.99331 10.0697 2.04189 10.259 2.14054 10.4229C2.23919 10.5869 2.38359 10.7185 2.55601 10.8015L7.86601 13.3365C8.02383 13.4126 8.19925 13.4448 8.37382 13.4297C8.54839 13.4145 8.71565 13.3526 8.85801 13.2505L15.43 8.56548L21.711 2.28448C21.5762 2.15096 21.4055 2.05932 21.2198 2.02064C21.034 1.98196 20.8409 1.99788 20.664 2.06648Z" fill="black"></path>
										</svg>
									</span>
									Email to Client
								</a>
							</div>
						</div>
					</div>

				</div>
				<!--end::Wrapper-->
			</div>
		</div>
	</div>
</div>
<div class="row mb-2 g-6 g-xl-9 loading" id="unschedule-block">
	<div class="alert alert-dismissible bg-light-danger d-flex flex-center flex-column py-10 px-10 px-lg-20 mb-10">
		<span class="svg-icon svg-icon-5tx svg-icon-danger mb-5">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
				<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="black"></rect>
				<rect x="11" y="14" width="7" height="2" rx="1" transform="rotate(-90 11 14)" fill="black"></rect>
				<rect x="11" y="17" width="2" height="2" rx="1" transform="rotate(-90 11 17)" fill="black"></rect>
			</svg>
		</span>
		<!--end::Svg Icon-->
		<!--end::Icon-->
		<!--begin::Content-->
		<div class="text-center text-dark">
			<h1 class="fw-bolder mb-5">Unable to create schedule.</h1>
			<div class="separator separator-dashed border-danger opacity-25 mb-5"></div>
			<div class="mb-9 text-start">
				<p>This project includes estimate categories that have not yet been mapped to any construction schedule tasks. </p><p>Here are the following items:</p>
				<p id="unScheduledLineItems" class="scrollable-items"></p>
				<p>Please use the mapping function to map the items before creating a schedule. </p><br>
			</div>
			<!--begin::Buttons-->
			<!--end::Buttons-->
		</div>
		<!--end::Content-->
	</div>
</div>
<div class="row mb-2 g-6 g-xl-9 content-hidden" id="schedule-block">
	<div class="card card-flush h-lg-100 p-0" id="schedule-body">	
		<!--begin::Card header-->
		<div class="card-header loading schedule-content ribbon ribbon-end ribbon-clip">
			<h3 class="fw-bolder mb-5 mt-5">Schedule</h3>
			<div class="ribbon-label d-none draft">
				DRAFT
				<span class="ribbon-inner bg-primary"></span>
			</div>
			<div class="ribbon-label d-none final">
				FINAL
				<span class="ribbon-inner bg-success"></span>
			</div>
		</div>
		
		<div class="card-body pt-0 loading schedule-content" id="schedule-details">
			@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 7, Header = false, CardBody = false })
			<div class="row">
				<div class="card-title flex-column justify-content-start align-items-start">
					<div class="d-flex flex-wrap">
						<div class="justify-content-lg-start" style="flex:1;">
							<div class="input-group input-group-sm w-250px">
								<span class="input-group-text" id="basic-addon1">Start Date</span>
								<input type="text" class="form-control form-control-sm" placeholder="Enter Date" id="txtStartDate" disabled>
							</div>
						</div>
						<div class="d-flex justify-content-end mb-5" style="flex:1;">
							<button type="button" class="btn btn-sm btn-light-danger ms-2 min-w-lg-125px align-self-end delay-controls d-none" id="btnAddDelay" evt-click="showAddDelayForm">
								<i class="bi bi-clock"></i>
								<span class="indicator-label">Add Delay</span>
							</button>
							<button type="button" class="btn btn-sm btn-light-primary ms-2 min-w-lg-125px align-self-end delay-controls d-none" evt-click="showDelays" id="btnShowDelays">
								<i class="bi bi-eye"></i>
								<span class="indicator-label">Show Delays</span>
							</button>
							<button type="button" class="btn btn-sm btn-outline btn-outline-dashed btn-outline-primary btn-active-light-primary align-self-end ms-2"
									evt-click="onAddNewItem">
									<i class="bi bi-plus"></i>
									<span class="indicator-label">Add New Item</span>
							</button>
								<button type="button" class="btn btn-sm btn-outline btn-outline-dashed btn-outline-danger btn-active-light-danger align-self-end ms-2"
									evt-click="onDeleteItems">
									<i class="bi bi-trash"></i>
									<span class="indicator-label">Delete Items</span>
								</button>
						</div>
					</div>

					
				</div>
			</div>
			<div class="table-responsive">
				<table class="table table-cell-bordered schedule-table">
					<thead class="sticky-header">
						<tr class="fw-bolder fs-6 text-gray-800 bg-light border-3">
							<th class="ps-2 w-75px text-center">Seq</th>
							<th class="text-center min-w-250px mw-250px">Name</th>
							<th class="text-center w-50px">Duration</th>
							<th class="text-center min-w-125px">Start Date</th>
							<th class="text-center min-w-125px">End Date</th>
							<th class="text-center min-w-250px mw-150px">Predecessor</th>
							<th class="text-center w-50px">Lag</th>
						</tr>
					</thead>
					<tbody id="schedule-details-body">
						
					</tbody>
				</table>
			</div>
		</div>
		<!--end::Card body-->
	</div>
</div>

@await Html.PartialAsync("components/add-delay-drawer.cshtml")
@await Html.PartialAsync("components/add-item-drawer.cshtml")
@await Html.PartialAsync("components/delay-list-drawer.cshtml")
@await Html.PartialAsync("components/delete-item-drawer.cshtml")
@await Html.PartialAsync("components/action-menu-bar.cshtml")