<div class="bg-body"
	 id="drawer-add-delay"
	 data-kt-drawer="true"
	 data-kt-drawer-activate="true"
	 data-kt-drawer-overlay="true"
	 data-kt-drawer-width="{default:'300px', 'lg': '450px'}"
	 data-kt-drawer-direction="end"
	 data-kt-drawer-close="#kt_add_delay_close"
	>

	<div class="col-md-12">
		<div class="card shadow-none rounded-0">
			<!--begin::Header-->
			<div class="card-header" id="kt_add_delay_header">
				<h3 class="card-title fw-bolder text-dark">Add Delay</h3>
				<div class="card-toolbar">
					<button type="button" class="btn btn-sm btn-icon btn-active-light-primary me-n5" id="kt_add_delay_close">
						<!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
						<span class="svg-icon svg-icon-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
								<rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
							</svg>
						</span>
						<!--end::Svg Icon-->
					</button>
				</div>
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body position-relative" id="kt_add_delay_body">
				<div id="kt_activities_scroll" class="position-relative scroll-y me-n5 pe-5"
					 data-kt-scroll="true" data-kt-scroll-height="auto"
					 data-kt-scroll-wrappers="#kt_add_delay_body"
					 data-kt-scroll-dependencies="#kt_add_delay_header, #kt_add_delay_footer"
					 data-kt-scroll-offset="5px">
					<form id="frmAddDelay">
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Delay Starts</label>
							<input type="text" class="form-control form-control-sm" placeholder="Enter Date" name="startDate" id="txtDelayStart">
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Construction Task</label>
							<select class="form-select form-select-sm"
									data-control="new-item-select2"
									id="slcAddDelayConstructionTask"
									name="addDelayConstructionTask">
							</select>
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Reason</label>
							<select class="form-select" name="reason" data-placeholder="Select a reason" id="slcDelayReason" evt-change="setReason">
								<option value=""></option>
								<option value="1">Weather</option>
								<option value="2">Sub-Contractor</option>
								<option value="3">Client</option>
								<option value="4">Delivery</option>
								<option value="5">Other</option>
							</select>
						</div>
						<div class="fv-row mb-5">
							<label class="fs-6 fw-bold required mb-2">Description</label>
							<textarea class="form-control form-control-solid" id="txtDelayDescription" style="resize:none;height:200px;font-size:13px;"></textarea>
						</div>
						<div class="fv-row mb-5">
							<label class="fs-6 fw-bold required mb-2">Days</label>
							<input class="form-control form-control-solid" data-type="int" name="days" placeholder="Number of days" id="txtDelayDays" />
						</div>
						<div class="fv-row mb-2 row-apply-other d-none">
							<label class="form-check form-switch form-check-custom form-check-solid">
								<input class="form-check-input" type="checkbox" value="1" id="chkApplyToOtherProjects"/>
								<span class="form-check-label fw-bold text-muted">
									Apply to other active projects
								</span>
							</label>
						</div>
						
					</form>
				</div>
			</div>
			<!--end::Body-->
			<!--begin::Footer-->
			<div class="card-footer py-3 text-center" id="kt_add_delay_footer">
				<button type="button" class="btn btn-sm btn-light-primary" id="btnSaveDelay" evt-click="onSaveDelay">
					<span class="indicator-label">
						<i class="bi bi-save"></i>Save Delay
					</span>
				</button>
			</div>
			<!--end::Footer-->
		</div>
	</div>
</div>