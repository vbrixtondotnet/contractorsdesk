<div class="bg-body"
	 id="drawer-add-item"
	 data-kt-drawer="true"
	 data-kt-drawer-activate="true"
	 data-kt-drawer-overlay="true"
	 data-kt-drawer-width="{default:'300px', 'lg': '450px'}"
	 data-kt-drawer-direction="end"
	 data-kt-drawer-close="#kt_add_item_close"
	>

	<div class="col-md-12">
		<div class="card shadow-none rounded-0">
			<!--begin::Header-->
			<div class="card-header" id="kt_add_item_header">
				<h3 class="card-title fw-bolder text-dark">Add New Item</h3>
				<div class="card-toolbar">
					<button type="button" class="btn btn-sm btn-icon btn-active-light-primary me-n5" id="kt_add_item_close">
						<!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
						<span class="svg-icon svg-icon-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
								<rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
							</svg>
						</span>
						<!--end::Svg Icon-->
					</button>
				</div>
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body position-relative" id="kt_add_item_body">
				<div id="kt_activities_scroll" class="position-relative scroll-y me-n5 pe-5"
					 data-kt-scroll="true" data-kt-scroll-height="auto"
					 data-kt-scroll-wrappers="#kt_add_item_body"
					 data-kt-scroll-dependencies="#kt_add_item_header, #kt_add_item_footer"
					 data-kt-scroll-offset="5px">
					<form id="frmAddItem">
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Name</label>
							<input type="text" class="form-control form-control-sm" placeholder="Enter Item Name" name="name" id="txtAddItemName">
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Duration</label>
							<input type="text" class="form-control form-control-sm" data-type="int" placeholder="Enter Duration" name="duration" id="txtAddItemDuration">
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Predecessor</label>
							<select class="form-select form-select-sm"
								data-control="new-item-select2"
								id="slcAddItemPred1">
							</select>
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Lag</label>
							<input type="text" class="form-control form-control-sm" placeholder="Enter Lag 1" name="lag1" id="txtAddItemLag1">
						</div>
						@* <div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Pred 2</label>
							<select class="form-select form-select-sm"
									data-control="new-item-select2"
									id="slcAddItemPred2">
							</select>
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2">Lag 2</label>
							<input type="text" class="form-control form-control-sm" placeholder="Enter Lag 2" name="lag2" id="txtAddItemLag2">
						</div> *@
						
					</form>
				</div>
			</div>
			<!--end::Body-->
			<!--begin::Footer-->
			<div class="card-footer py-3 text-center" id="kt_add_item_footer">
				@await Html.PartialAsync("Components/Buttons/Save", new { OnSave = "onSaveItem" })
			</div>
			<!--end::Footer-->
		</div>
	</div>
</div>