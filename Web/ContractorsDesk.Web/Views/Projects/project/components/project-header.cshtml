@using ContractorsDesk.Core.Enums;
@{
	var CurrentRole = (Roles?)ViewBag.Role;
}
<div class="d-flex flex-wrap flex-sm-nowrap mb-6">

	<div class="flex-grow-1">
		<!--begin::Head-->
		<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
			<!--begin::Details-->
			<div class="d-flex flex-column">
				<!--begin::Status-->
				<div class="d-flex align-items-center mb-1">
					<a href="javascript:" class="text-gray-800 text-hover-primary fs-1 fw-bolder me-3" id="txt-project-title" data-bookmark-title="true"></a>
					<span class="badge me-auto" id="txt-project-status">Active</span>
				</div>
				<!--end::Status-->
				<!--begin::Description-->
				<div class="d-flex flex-wrap fw-bold mb-2 fs-5 text-gray-400" id="txt-project-description">Short description of the project. You can set this in the project settings.</div>
				
			</div>
			@if (CurrentRole != Roles.Client)
			{
				<div class="d-flex flex-column align-items-start mb-4">
					<a href="#" class="btn btn-light btn-active-light-primary btn-sm" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
						Actions <i class="fas fa-chevron-down"></i>
					</a>
					<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-200px py-4" data-kt-menu="true">
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="sendClientEmail">Email to Client</a>
						</div>
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="sendStatusReport">Send Status Report</a>
						</div>
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="sendProposal" id="sendProposalMenuItem">Send Proposal</a>
						</div>
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="sendScheduleReport" id="sentScheduleReportMenuItem">Send Schedule Report</a>
						</div>
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="sendBudgetToActualReport" id="sendBudgetToActualReportMenuItem">Send Budget to Actual Report</a>
						</div>
						<div class="menu-item px-3">
							<a href="javascript:" class="menu-link px-3 archive proposal-action" evt-click="onCreateInvoiceClick">Create Invoice</a>
						</div>
					</div>
				</div>
			}
		</div>
		<!--end::Head-->
		<!--begin::Info-->
		<div class="d-flex flex-wrap justify-content-start">
			<!--begin::Stats-->
			<div class="d-flex flex-wrap">
				<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" style="align-content:center;">
					<!--begin::Number-->
					<div class="d-flex align-items-center">
						<div class="fs-4 fw-bolder" data-model="startdate"></div>
					</div>
					<!--end::Number-->
					<!--begin::Label-->
					<div class="fw-bold fs-6 text-gray-400 text-center">Start Date</div>
					<!--end::Label-->
				</div>
				<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" style="align-content:center;">
					<!--begin::Number-->
					<div class="text-center">
						<div class="fs-4 fw-bolder" data-model="endDate"></div>
					</div>
					<!--end::Number-->
					<!--begin::Label-->
					<div class="fw-bold fs-6 text-gray-400 text-center">Est. Completion Date</div>
					<!--end::Label-->
				</div>
				<div id="dv-supervisors" class="d-flex">
					
				</div>
			</div>
			<!--end::Stats-->
			<!--begin::Users-->
			<!--end::Users-->
		</div>
		<!--end::Info-->
	</div>
	<!--end::Wrapper-->
</div>