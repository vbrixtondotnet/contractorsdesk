@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.LoadComponents(new string[]{
	"sticky-actions"
})

<div class="row mb-2 g-6 g-xl-9 category-row">
	<div class="col-lg-12">
		<div class="card card-flush h-lg-100">
			<!--begin::Card header-->
			<div class="px-10 pb-5 pt-5">
				@* <div class="card-header d-flex justify-content-between align-items-center">
					<h1 class="card-title">Card Title</h1>
					<button type="button" class="btn btn-primary">Action</button>
				</div> *@
				<!--begin::Card title-->
				<div class="card-title d-flex justify-content-between align-items-center">
					<h3 class="fw-bolder mb-1 flex-shrink-0" data-bookmark-title="true">Estimate Data Mapping</h3>
					<div class="d-flex align-items-center">
						<button type="button" class="btn btn-sm bg-primary  me-2  text-inverse-primary" evt-click="saveEstimateMappings">
							<span class="indicator-label"> Save</span>
							<span class="indicator-progress">
								Please wait...
								<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
							</span>
						</button>
						<button type="button" class="btn btn-sm bg-light  me-2  text-inverse-light" evt-click="cancelChanges">
							Cancel
						</button>
						@* <button type="button" class="btn btn-sm bg-secondary  me-2  text-inverse-secondary">
							Print
						</button> *@
					</div>
				</div>

			</div>
			<div class="px-10 pb-2 pt-5">
				<div class="input-group input-group-sm mb-5">
					<span class="input-group-text">Search</span>
					<input type="text" class="form-control" evt-keyup="filterRows">
					<span class="input-group-text p-0">
						<button type="button" class="btn btn-sm bg-light text-inverse-light" evt-click="clearFilter">
							CLEAR
						</button>
					</span>
				</div>
			</div>
			<!--end::Card header-->
			<!--begin::Card body-->
			<div class="card-body pt-0 loading" id="dv-datamappings">
				@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 30, Header = false, CardBody = false })
                <table class="table table-cell-bordered proposal-items estimate-data-mapping-table">
                    <colgroup>
                        <col style="width:40%">
                        <col style="width:60%">
                    </colgroup>
                    <tbody id="body-data-mappings">
                            
                    </tbody>
                </table>
			</div>
			<!--end::Card body-->
		</div>
	</div>
</div>