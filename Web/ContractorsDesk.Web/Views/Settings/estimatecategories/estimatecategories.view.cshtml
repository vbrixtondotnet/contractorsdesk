@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.LoadComponents(new string[]{
	"sticky-actions",
	"virtual-select",
	"tagify-select",
	"sticky-header",
	"autocomplete"
})

<div class="row mb-2 g-6 g-xl-9 category-row">
	<div class="col-lg-12">
		<div class="card card-flush h-lg-100">
			<!--begin::Card header-->
			<div class="px-10 pb-5 pt-5">
				<div class="card-title d-flex justify-content-between align-items-center">
					<h3 class="fw-bolder mb-1 flex-shrink-0" data-bookmark-title="true">Estimate Categories</h3>
					<div class="d-flex align-items-center">
						<button type="button" class="btn btn-sm bg-primary  me-2  text-inverse-primary" evt-click="saveEstimateCategories">
							<span class="indicator-label"> Save</span>
							<span class="indicator-progress">
								Please wait...
								<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
							</span>
						</button>
						<button type="button" class="btn btn-sm bg-light  me-2  text-inverse-light" evt-click="cancelChanges">
							Cancel
						</button>
						@* <button type="button" class="btn btn-sm bg-secondary  me-2  text-inverse-secondary">
							Print
						</button> *@
					</div>
				</div>

			</div>
			<div class="px-10 pb-2 pt-5">
				<div class="input-group input-group-sm mb-5">
					<span class="input-group-text">Search</span>
					<input type="text" class="form-control" evt-input="filterRows">
					<span class="input-group-text p-0">
						<button type="button" class="btn btn-sm bg-light text-inverse-light" evt-click="clearFilter">
							CLEAR
						</button>
					</span>
					<button type="button" class="btn btn-sm bg-primary ms-2 text-inverse-primary" evt-click="toggleCategoryForm">
						+ ADD NEW
					</button>
				</div>
			</div>
			<!--end::Card header-->
			<!--begin::Card body-->
			<div class="card-body pt-0 loading" id="dv-estimatecategories">
				@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 30, Header = false, CardBody = false })
                <table class="table table-cell-bordered proposal-items">
                    <thead class="sticky-header">
                        <tr class="fw-bolder fs-6 text-gray-800 bg-light">
							<th class="ps-2"> Estimate Category</th>
							<th class="w-300px">Parent Category</th>
							<th class="w-50px"></th>
                        </tr>
                    </thead>
                    <tbody id="body-estimatecategories">
                            
                    </tbody>
                </table>
			</div>
			<!--end::Card body-->
		</div>
	</div>
</div>

@await Html.PartialAsync("Components/EstimateCategoryForm/EstimateCategoryForm")