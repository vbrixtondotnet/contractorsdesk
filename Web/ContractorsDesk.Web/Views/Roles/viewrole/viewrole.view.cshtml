@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.RenderSharedComponentStyle("tableloader", "tableloader.css")

<div class="d-flex flex-column flex-lg-row">
	<!--begin::Sidebar-->
	<div class="flex-column flex-lg-row-auto w-100 w-lg-200px w-xl-300px mb-10">
		<div id="dvRoleDetails" style="height:505px;">
			@await Html.PartialAsync("Components/listloader/listloader")
		</div>
	</div>
	<!--end::Sidebar-->
	<!--begin::Content-->
	<div class="flex-lg-row-fluid ms-lg-10">
		<div id="dvRoleUsers">
			@await Html.PartialAsync("Components/tableloader/tableloader")
		</div>
		
	</div>
	<!--end::Content-->
</div>