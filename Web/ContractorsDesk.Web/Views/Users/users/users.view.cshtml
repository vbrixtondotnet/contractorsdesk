@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")

<div class="col-lg-12">
	<div class="card card-flush h-lg-100 has-shadow">
		<div id="users-listview">
		</div>
	</div>
</div>



<div class="d-none">
	<button id="btnAddUserToggle"></button>
</div>

<div class="d-none">
	<button id="btnEditUserToggle"></button>
</div>

<div class="bg-body"
	 data-kt-drawer="true"
	 data-kt-drawer-name="users"
	 data-kt-drawer-activate="true"
	 data-kt-drawer-overlay="true"
	 data-kt-drawer-width="{default:'300px', 'lg': '450px'}"
	 data-kt-drawer-direction="end"
	 data-kt-drawer-toggle="#btnAddUserToggle"
	 data-kt-drawer-close="#kt_user_close">
	<div class="col-md-12">
		<div class="card shadow-none rounded-0">
			<!--begin::Header-->
			<div class="card-header" id="kt_addUser_header">
				<h3 class="card-title fw-bolder text-dark">Add User</h3>
				<div class="card-toolbar">
					<button type="button" class="btn btn-sm btn-icon btn-active-light-primary me-n5" id="kt_user_close">
						<!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
						<span class="svg-icon svg-icon-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
								<rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
							</svg>
						</span>
						<!--end::Svg Icon-->
					</button>
				</div>
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body position-relative" id="kt_addUser_body">
				<div id="kt_activities_scroll" class="position-relative scroll-y me-n5 pe-5"
					 data-kt-scroll="true" data-kt-scroll-height="auto"
					 data-kt-scroll-wrappers="#kt_addUser_body"
					 data-kt-scroll-dependencies="#kt_addUser_header, #kt_addUser_footer"
					 data-kt-scroll-offset="5px">
					<form id="frmUser">
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">First Name</label>
							<input type="text" name="firstName" class="form-control form-control-solid" placeholder="" id="firstName" />
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Last Name</label>
							<input type="text" name="lastName" class="form-control form-control-solid" placeholder="" id="lastName" />
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Email Address</label>
							<input type="email" name="email" class="form-control form-control-solid" placeholder="" id="email" />
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2 required">Password</label>
							<input type="password" name="password" class="form-control form-control-solid" placeholder="" id="password" />
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold mb-2 required">Confirm Password</label>
							<input type="password" name="confirmPassword" class="form-control form-control-solid" placeholder="" id="confirmPassword" />
						</div>
						<div class="fv-row mb-2">
							<label class="fs-6 fw-bold required mb-2">Role</label>
							<select class="form-select" data-control="select2" name="role" data-placeholder="Select a role" id="slcAddUserRole">
							</select>
						</div>
					</form>
				</div>
			</div>
			<!--end::Body-->
			<!--begin::Footer-->
			<div class="card-footer py-3 text-center" id="kt_addUser_footer">
				<button type="button" class="btn btn-sm btn-light-primary" id="btnSaveUser" fdprocessedid="px298d">
					<span class="indicator-label">
						<i class="bi bi-save"></i>Submit
					</span>
					<span class="indicator-progress">
						Saving...
						<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
					</span>
				</button>
			</div>
			<!--end::Footer-->
		</div>
	</div>
</div>
<!--begin::Row-->

<div class="bg-body"
	 data-kt-drawer="true"
	 data-kt-drawer-name="editUsers"
	 data-kt-drawer-activate="true"
	 data-kt-drawer-overlay="true"
