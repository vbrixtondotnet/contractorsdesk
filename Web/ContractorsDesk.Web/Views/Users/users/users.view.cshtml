							</select>
						</div>
					</form>
				</div>
			</div>
			<!--end::Body-->
			<!--begin::Footer-->
			<div class="card-footer py-3 text-center" id="kt_editUser_footer">
				<button type="button" class="btn btn-sm btn-light-primary" id="btnUpdateUser" fdprocessedid="px298d">
					<span class="indicator-label">
						<i class="bi bi-save"></i>Submit
					</span>
					<span class="indicator-progress">
						Saving...
						<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
					</span>
				</button>
			</div>
			<!--end::Footer-->
		</div>
	</div>
</div>
<!--begin::Row-->
