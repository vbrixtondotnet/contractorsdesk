@using System.Text.Json
@using ContractorsDesk.Core.Dto;
@{
	var appUserClaim = User.FindFirst("ApplicationUser")?.Value;
	var companySettings = (CompanySettingDto)ViewBag.CompanySettings;
	var hasQuickBooksAccountConnected = companySettings.QuickbooksConnected;
	var Permissions = (PermissionViewModel)ViewBag.Permissions;
	ApplicationUserModel applicationUser = null;
	string initials = string.Empty;
	string avatarUrl = string.Empty;


	if (!string.IsNullOrWhiteSpace(appUserClaim))
	{ 
		applicationUser = JsonSerializer.Deserialize<ApplicationUserModel>(appUserClaim);
		initials = applicationUser.FirstName.Substring(0, 1) +
					(!string.IsNullOrEmpty(applicationUser.LastName) ? applicationUser.LastName.Substring(0, 1) : string.Empty);

		avatarUrl = applicationUser.AvatarUrl;
	}

	string fullName = $"{applicationUser?.FirstName} {applicationUser?.LastName}";
	string email = applicationUser?.Email;
	string role = applicationUser?.Role;
}
<div class="d-flex align-items-center px-2">
	<a href="javascript:" class="btn btn-sm btn-icon btn-dark btn-active-icon-primary rounded-circle" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start" data-kt-menu-overflow="false">
		@initials
	</a>
	<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-300px" data-kt-menu="true">
		<!--begin::Menu item-->
		<div class="menu-item px-3">
			<div class="menu-content d-flex align-items-center px-3">
				<!--begin::Avatar-->
				<div class="symbol symbol-circle symbol-50px me-5">
					<img src="@avatarUrl" alt="image">
					<input type="file" data-model="photo" style="display:none;" evt-change="onPhotoFileSelected">
				</div>
				@* <div class="symbol symbol-circle symbol-50px me-5">
					<div class="symbol-label fs-3 bg-dark text-white">@initials</div>
				</div> *@
				<!--end::Avatar-->
				<!--begin::Username-->
				<div class="d-flex flex-column">
					<div class="fw-bolder d-flex align-items-center fs-5">
						@fullName
					</div>
					<a href="#" class="fw-bold text-muted text-hover-primary fs-7">@email</a>

					<span class="badge badge-success mt-2">@role</span>

				</div>
				<!--end::Username-->
			</div>
		</div>
		<!--end::Menu item-->
		<!--begin::Menu separator-->
		<div class="separator my-2"></div>
		<div class="menu-item px-5">
			<a href="/users/account" class="menu-link px-5">
				<span class="menu-text">My Account</span>
			</a>
		</div>
		@if (Permissions.CanAccessDataSyncServices)
		{
			if (hasQuickBooksAccountConnected)
			{
				<div class="menu-item px-5">
					<a href="javascript:" class="menu-link px-5" evt-click="onTriggerQBDataSync">
						<span class="menu-text">Trigger QuickBooks Data Sync</span>
					</a>
				</div>
			}
			else
			{
				<div class="menu-item px-5">
					<a href="/quickbooks/connect" class="menu-link btn btn-sm btn-primary text-white px-5 text-center">
						<span class="svg-icon svg-icon-muted svg-icon-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<path opacity="0.3" d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z" fill="black" />
								<path d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z" fill="black" />
							</svg>
						</span>
						<span class="menu-text">Connect QuickBooks Account</span>
					</a>
				</div>
			}

		}
		@* <div class="separator my-2"></div>
		<!--end::Menu item-->
		<!--begin::Menu item-->
		<div class="menu-item px-5 my-1">
		<a href="../../demo8/dist/account/settings.html" class="menu-link px-5">Switch Company</a>
		</div>

		<!--end::Menu item-->
		<!--begin::Menu separator--> *@
		<div class="separator my-2"></div>
		<!--end::Menu separator-->
		<!--begin::Menu item-->
		<div class="menu-item px-5">
			<a href="/signout" class="menu-link px-5">Sign Out</a>
		</div>
		<!--end::Menu item-->
	</div>
</div>