					<div class="flex-grow-1 me-2">
						<!--begin::Username-->
						<a href="@linkHref" class="text-white text-hover-primary fs-6 fw-bold">@CompanySettings.CompanyName</a>
						<!--end::Label-->
					</div>
				</div>
				<!--end::Section-->
			</div>
			<!--end::Wrapper-->
		</div>
		<div class="aside-search py-5">
