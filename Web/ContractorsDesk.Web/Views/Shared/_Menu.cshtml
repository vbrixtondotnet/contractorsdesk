    var Permissions = (PermissionViewModel)ViewBag.Permissions;
    var CurrentRole = (Roles?)ViewBag.Role;
	var CompanySettings = (CompanySettingDto)ViewBag.CompanySettings;
	var ApplicationUser = (ApplicationUserModel)ViewBag.CurrentUser;
	var linkHref = Permissions.CanAccessCompanySettings
			? "/company-settings"
			: "/";
