@using ContractorsDesk.WebPortal.Helpers
@using ContractorsDesk.Core.Dto;

<!DOCTYPE html>

<html lang="en">
<!--begin::Head-->
<head>
	<base href="">
	<title>ContractorsDesk - @ViewBag.Title</title>
	<meta charset="utf-8" />
	<meta name="description" content="" />
	<meta name="keywords" content="" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:type" content="article" />
	<meta property="og:title" content="ContractorsDesk" />
	<meta property="og:url" content="https://keenthemes.com/metronic" />
	<meta property="og:site_name" content="Keenthemes | Metronic" />
	<link rel="canonical" href="https://preview.keenthemes.com/metronic8" />
	<link rel="shortcut icon" href="/assets/media/logos/favicon.ico" />
	<!--begin::Fonts-->
	<link rel="stylesheet" href="/assets/fonts/poppins.css" />
	<!--end::Fonts-->
	<!--begin::Page Vendor Stylesheets(used by this page)-->
	<link href="/assets/plugins/custom/fullcalendar/fullcalendar.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Page Vendor Stylesheets-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />

	<script src="/assets/plugins/global/plugins.bundle.js"></script>
	<script src="/assets/js/scripts.bundle.js"></script>
	@Html.RenderViewStyles()
	<!--end::Global Stylesheets Bundle-->
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="header-tablet-and-mobile-fixed aside-enabled">
	<!--begin::Main-->
	<!--begin::Root-->
	<div class="d-flex flex-column flex-root">
		<!--begin::Page-->
		<div class="page d-flex flex-row flex-column-fluid">
			<!--begin::Aside-->
			@await Html.PartialAsync("_Menu")
			<!--end::Aside-->
			<!--begin::Wrapper-->
			<div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">
				<!--begin::Header-->
				@await Html.PartialAsync("_Header")
				<!--end::Header-->
				<!--begin::Content-->
				<div class="content d-flex flex-column flex-column-fluid" id="kt_content" style="padding-bottom:0;">
					<div class="post d-flex flex-column-fluid" id="kt_post">
						<!--begin::Container-->
						<div id="kt_content_container" class="container-xxl">
							
							@Html.LoadComponents(new string[] {
								"config",
								"global",
								"enums",
								"httpservice",
								"cacheservice",
								"domeventcomponent",
								"swal", 
								"arrayutilities", 
								"doutune", 
								"bookmarks", 
								"forms",
								"printer",
								"listview",
								"drawer",
								"searchable-dropdown",
								"signalr",
								"createnote",
								"ck-document-editor",
								"email-sender",
								"action-item-form",
								"subcontractor-form",
								"webapp-idle",
								"app"
							})
							@RenderBody()
						</div>
					</div>
				</div>
				<!--end::Content-->
				<!--begin::Footer-->
				@* @await Html.PartialAsync("_Footer") *@
				<!--end::Footer-->
			</div>
			<!--end::Wrapper-->
		</div>
		<!--end::Page-->
	</div>
	<!--end::Root-->
	<!--begin::Drawers-->
	<!--begin::Notifications drawer-->
	@await Html.PartialAsync("_Notifications")
	@await Html.PartialAsync("_BackgroundProcessMessages")
	@await Html.PartialAsync("Components/CreateNote/CreateNote")
	@await Html.PartialAsync("Components/ActionItemForm/action-item-form")
	@await Html.PartialAsync("Components/SubcontractorForm/subcontractor-form")
	@await Html.PartialAsync("Components/ManagerProjects/managerprojects")
	@await Html.PartialAsync("Components/EmailSender/EmailSender")
	<audio src="/assets/audio/notification-alert.wav" class="notification-sound d-none" controls="controls"></audio>
	
	<!--end::Drawers-->
	
	<!--begin::Scrolltop-->
	<div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
		<!--begin::Svg Icon | path: icons/duotune/arrows/arr066.svg-->
		<span class="svg-icon">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
				<rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="black" />
				<path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="black" />
			</svg>
		</span>
		<!--end::Svg Icon-->
	</div>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
	@Html.RenderViewScripts()
	@{
		var bookmarksLoaderModel = new { LinesCount = 7, Header = false, CardBody = false };
		var Permissions = (PermissionViewModel)ViewBag.Permissions;
		var permissionsJson = System.Text.Json.JsonSerializer.Serialize(Permissions);
		var companySettings = (CompanySettingDto)ViewBag.CompanySettings;
		var companySettingsJson = System.Text.Json.JsonSerializer.Serialize(companySettings);
	}
	<script defer>
		const permissions = @Html.Raw(@permissionsJson);
		localStorage.setItem('permissions', JSON.stringify(permissions));

		const companySettingsRaw = @Html.Raw(@companySettingsJson);
		localStorage.setItem('companySettings', JSON.stringify(companySettingsRaw));
	</script>
	<style>
		elevenlabs-convai {
			position: fixed;
			bottom: 20px;
			right: 20px;
			z-index: 9999;
		}

		/* Adjust spacing for smaller screens */
		@@media (max-width: 768px) {
			elevenlabs-convai {
				bottom: 80px; /* extra lift in case of mobile nav bars or other UI */
				right: 10px;
				transform: scale(0.9); /* optional: slightly smaller for mobile */
			}
		}

		/* Very small screens */
		@@media (max-width: 480px) {
			elevenlabs-convai {
				bottom: 90px;
				right: 5px;
				transform: scale(0.85);
			}
		}
	</style>
	<elevenlabs-convai agent-id="agent_1301k43b40pteb08sse87xy05t1f"></elevenlabs-convai>
	<script src="https://unpkg.com/@@elevenlabs/convai-widget-embed@beta" async type="text/javascript"></script>
	
	<!--end::Global Javascript Bundle-->
	<!--end::Javascript-->
</body>
<!--end::Body-->
</html>