<div class="bg-body"
	 id="create-note-component-drawer"
	 data-kt-drawer="true"
	 data-kt-drawer-activate="true"
	 data-kt-drawer-overlay="true"
	 data-kt-drawer-width="{default:'300px', 'lg': '450px'}"
	 data-kt-drawer-direction="end"
	 data-kt-drawer-toggle="#btnToggleCreateNote"
	 data-kt-drawer-close="#action-item-note-component-close">
	<div class="col-md-12">
		<div class="card shadow-none rounded-0 h-100">
			<!--begin::Header-->
			<div class="card-header" id="action-item-note-component-header">
				<h3 class="card-title fw-bolder text-dark">Create Note</h3>
				<div class="card-toolbar">
					<button type="button" class="btn btn-sm btn-icon btn-active-light-primary me-n5" id="action-item-note-component-close">
						<!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
						<span class="svg-icon svg-icon-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
								<rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
							</svg>
						</span>
						<!--end::Svg Icon-->
					</button>
				</div>
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body position-relative" id="action-item-note-component-body">
				<div id="kt_activities_scroll" class="position-relative scroll-y me-n5 pe-5"
					 data-kt-scroll="true" data-kt-scroll-height="auto"
					 data-kt-scroll-wrappers="#action-item-note-component-body"
					 data-kt-scroll-dependencies="#action-item-note-component-header, #action-item-note-component-footer"
					 data-kt-scroll-offset="5px">
					<form id="frmCreateActionItemNote">
						<div class="row">
							<div class="fv-row mb-2">
								<label class="fs-6 fw-bold mb-2">Assigned To</label>
								<select class="form-select always-enabled" required data-control="select2" name="assignedTo" id="slcCreateNoteAssignedTo">
									<option value="0" selected>Search user</option>
								</select>
							</div>
							<div class="fv-row mb-2">
								<label class="fs-6 fw-bold mb-2">Title</label>
								<input type="text" class="form-control" name="title" id="txtNoteTitle"/>
							</div>
							<div class="fv-row mb-2">
								<label class="fs-6 fw-bold mb-2">Description</label>
								<textarea class="form-control" required id="txtNote" name="note" rows="6" placeholder="Enter your note here" style="resize:none;"></textarea>
							</div>
						</div>
					</form>
				</div>
			</div>
			<!--end::Body-->
			<!--begin::Footer-->
			<div class="card-footer py-1 text-center" id="action-item-note-component-footer">
				<button type="button" class="btn btn-sm btn-primary always-enabled mt-1" evt-click="onSaveNote">
					<span class="indicator-label">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
							<path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z" />
						</svg>&nbsp;&nbsp;Save Note
					</span>
					<span class="indicator-progress">
						Creating Note...
						<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
					</span>
				</button>
			</div>
			<!--end::Footer-->
		</div>
	</div>
</div>