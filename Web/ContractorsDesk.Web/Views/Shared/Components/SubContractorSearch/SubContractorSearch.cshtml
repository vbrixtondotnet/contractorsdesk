@using ContractorsDesk.WebPortal.Helpers
<div class="modal fade" id="mdlSubContractorSearch" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content text-center p-4" style="border-radius: 10px;">
			<div class="modal-header border-0 pb-0">
				<h4 class="modal-title w-100 fw-bolder">Select a Sub-Contractor</h4>
			</div>
			<div class="modal-body">
				<div class="input-group input-group-sm mb-1" id="slcSubContractorsContainer">
					<select class="form-select form-select-sm form-select-solid" data-control="select2" id="slcSubContractors">
						<option value="0" selected>Select an existing sub-contractor</option>
					</select>
				</div>
				<form id="frmSubcontractorSearch" class="mt-5">
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", Label = "Name", LabelCssClass = "mn-w-125px", Id = "txtSearchSubContractorName", Name = "customerName", DataModel = "name", Required = true, CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", Label = "Address", LabelCssClass = "mn-w-125px", Id = "txtSearchSubContractorAddress", DataModel = "address", CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", LabelCssClass = "mn-w-125px", Label = "City", Id = "txtSearchSubContractorCity", Name = "customerCity", DataModel = "city", CustomInputClass = "subcontractor-search-input" })
					@Html.StatesDropdown(new HtmlElementModel { Classes = "form-select-sm subcontractor-search-input", Id = "txtSearchSubContractorState", DataModel = "state" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", Label = "Company", LabelCssClass = "mn-w-125px", Id = "txtSearchSubContractorCompany", DataModel = "company", CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", Label = "Email", LabelCssClass = "mn-w-125px", Id = "txtSearchSubContractorEmail", Name = "email", DataModel = "email", Required = true, CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", LabelCssClass = "mn-w-125px", Label = "Phone", Id = "txtSearchSubContractorPhone", Name = "customerPhone", DataModel = "phone", CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", LabelCssClass = "mn-w-125px", Label = "License #", Id = "txtSearchSubContractorLicenseNo", Name = "licenseNo", DataModel = "licenseNo", CustomInputClass = "subcontractor-search-input" })
					@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mb-2", LabelCssClass = "mn-w-125px", Label = "License Expiry", Id = "txtSearchSubContractorLicenseExpiry", Name = "licenseExpiry", DataModel = "licenseExp", Type = "date", CustomInputClass = "subcontractor-search-input" })
				</form>
			</div>
			<div class="modal-footer border-0 justify-content-center">
				<button class="btn btn-outline-secondary px-5" data-bs-dismiss="modal">Cancel</button>
				<button class="btn btn-primary px-5" id="btnSearchSubContractorNext">Next >></button>
			</div>
		</div>
	</div>
</div>
