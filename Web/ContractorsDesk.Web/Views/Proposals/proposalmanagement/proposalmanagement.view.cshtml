@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")

<div class="row g-6 g-xl-9">
	<!--begin::Col-->
	<div class="col-md-12 tabcontrol-item active" id="tab-action-items">
		<div class="card">
			<div class="card-header border-0 pt-6">
				<!--begin::Card title-->
				<div class="card-title">
					<!--begin::Search-->
					<div class="d-flex align-items-center position-relative my-1">
						<!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
						<span class="svg-icon svg-icon-1 position-absolute ms-6">
							<i class="bi bi-search"></i>
						</span>
						<!--end::Svg Icon-->
						<input type="text" data-kt-customer-table-filter="search" class="form-control form-control-solid w-lg-500px ps-15" placeholder="Search Proposals">
					</div>
					<!--end::Search-->
				</div>
				<!--begin::Card title-->
				<!--begin::Card toolbar-->
				<div class="card-toolbar">
					<!--begin::Toolbar-->
					<div class="d-flex justify-content-end">
						<a href="/proposals/00000000-0000-0000-0000-000000000000" class="btn btn-sm btn-light-primary create-proposal">
							<i class="bi bi-plus"></i>
							Create Proposal
						</a>
					</div>
					
				</div>
				<!--end::Card toolbar-->
			</div>
			<div class="card-body p-0 preload" role="tabpanel">
				@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 20, Header = false, CardBody = false })
				<div class="table-responsive">
					<!--begin::Table-->
					<table class="table table-flush align-middle table-row-bordered table-row-solid gy-4 gs-9">
						<!--begin::Thead-->
						<thead class="border-gray-200 fs-5 fw-bold bg-lighten">
							<tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
								<th class="px-9">Client</th>
								<th class="">Project</th>
								<th class="text-center">Proposal Number</th>
								<th class="">Date</th>
								<th class="">Amount</th>
								<th class="">Status</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>
						<!--end::Thead-->
						<!--begin::Tbody-->
						<tbody class="fs-6 fw-bold text-gray-600" id="tbody-proposals">
							
						</tbody>
						<!--end::Tbody-->
					</table>
					<!--end::Table-->
				</div>
			</div>
		</div>
	</div>
	
</div>