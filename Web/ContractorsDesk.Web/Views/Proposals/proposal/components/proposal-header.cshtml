@using ContractorsDesk.Core.Dto
@using ContractorsDesk.WebPortal.Helpers
@{
	var CompanySettings = (CompanySettingDto)ViewBag.CompanySettings;
	var Permissions = (PermissionViewModel)ViewBag.Permissions;
	var readOnly = !Permissions.CanManageAllEstimates && Permissions.CanManageOwnEstimates ? "readonly" : "";
}
<div class="flex-shrink-0 bg-white" style="justify-self:center;">
	<img class="mw-100px mw-lg-250px" src="@CompanySettings.CompanyLogoUrl" alt="image" />
</div>
<!--begin::Head-->
<div class="d-flex justify-content-between align-items-start flex-wrap mb-2 mt-4">
	<!--begin::Details-->
	<div class="d-flex flex-column">
		<!--begin::Status-->
		<div class="d-flex align-items-center mb-1">
			<a href="#" class="text-gray-800 text-hover-primary fs-2 fw-bolder me-3">
				@CompanySettings.CompanyName  
			</a>
		</div>
		<!--end::Status-->
		<!--begin::Description-->
		<div class="d-flex flex-wrap fw-bold mb-4 fs-5 text-gray-400">
			@if (!string.IsNullOrWhiteSpace(CompanySettings.Address1))
			{
				@CompanySettings.Address1<br />
			}
			@if (!string.IsNullOrWhiteSpace(CompanySettings.Address2))
			{
				@CompanySettings.Address2<br />
			}
			@if (!string.IsNullOrWhiteSpace(CompanySettings.City) || !string.IsNullOrWhiteSpace(CompanySettings.State) || !string.IsNullOrWhiteSpace(CompanySettings.Zip))
			{
				var cityStateZip = $"{CompanySettings.City}, {CompanySettings.State} {CompanySettings.Zip}".Trim(' ', ',');
				@cityStateZip<br />
			}
			@if (!string.IsNullOrWhiteSpace(CompanySettings.PhoneNumber))
			{
				<text>Phone: @CompanySettings.PhoneNumber<br /></text>
			}

			@if (!string.IsNullOrWhiteSpace(CompanySettings.CompanyEmail))
			{
				<text>Email: @CompanySettings.CompanyEmail</text>
			}
		</div>
		<!--end::Description-->
	</div>
	<!--end::Details-->
	<!--begin::Actions-->
	<div class="d-flex mw-lg-500px print-50">
		<div class="row">
			<div class="col-md-12">
				<h2 class="text-gray-800 fs-1 fw-bolder mb-5 justify-self-right"> Job Estimate Proposal<span id="lblProjectTitle"></span></h2>
				<div class="row">
					<div class="d-flex gap-3 mb-2">
						@Html.InputGroupTextbox(new InputGroupModel { CssClass = "input-group-sm mw-125px justify-self-right", Label = "Number", LabelCssClass = "mn-w-100px", Id = "txtProposalNumber", ReadOnly = true })
						@Html.InputGroupTextbox(new InputGroupModel { Type = "date", CssClass = "input-group-sm mw-lg-160px justify-self-right", Label = "Date", Id = "txtProposalDate" })

						<div class="input-group input-group-sm mw-lg-300px justify-self-right">
							<span class="input-group-text mn-w-85px" id="basic-addon3">Doc Status</span>
							<select class="form-select" id="slcProposalStatus" style="padding-right:0 !important;" evt-change="onChangeDocStatus" evt-ignore-change="true">
								<option selected value="1">Draft</option>
								<option value="2">Accepted</option>
							</select>
						</div>
					</div>
					<div class="d-flex gap-3 mb-2">
						<div class="input-group input-group-sm select-supervisor">
							<span class="input-group-text mn-w-125px">Supervisors</span>
							<select class="form-select" data-control="select2" multiple="multiple" data-placeholder="Select a Supervisor" id="slcSupervisors">
							</select>
						</div>
					</div>
					<div class="d-flex gap-3 mb-2">
						<div class="input-group input-group-sm justify-self-right">
							<span class="input-group-text mn-w-85px" id="basic-addon3">Template</span>
							<select class="form-select" id="slcTemplates" evt-change="onTemplateChange"></select>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
	<!--end::Actions-->
</div>
<div class="justify-self-right">
	
	<button type="button" class="btn btn-sm btn-bg-primary text-inverse-primary me-1 min-w-lg-100px" evt-click="saveProposal" id="btnSaveProposal">
		<span class="indicator-label">
			Save
		</span>
		<span class="indicator-progress">
			Please wait...
			<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
		</span>
	</button>
	<button class="btn btn-sm btn-success me-1 min-w-lg-100px always-enabled" evt-click="onEditProposal">Edit</button>
	<button class="btn btn-sm btn-secondary me-1" evt-click="onCancelBtn" id="cancelBtnHeader">Cancel</button>

	@await Html.PartialAsync("Components/KTMenuButton/KTMenuButton")
	@await Html.PartialAsync("action-menu-items.cshtml")

</div>