@using ContractorsDesk.Core.Dto
@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.LoadComponents(new string[]{
	"sticky-actions",
	"sticky-header"
})

<div class="card loading" id="dv-archived-projects">
	@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 25, Header = false, CardBody = false })
	<!--begin::Card header-->
	<div class="card-header border-0 pt-6">
		<!--begin::Card title-->
		<div class="card-title">
			<!--begin::Search-->
			<div class="d-flex align-items-center position-relative my-1">
				<!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
				<span class="svg-icon svg-icon-1 position-absolute ms-6">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
						<rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black"></rect>
						<path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black"></path>
					</svg>
				</span>
				<!--end::Svg Icon-->
				<input type="text" class="form-control form-control-solid w-250px ps-14" placeholder="Search Project" evt-keyup="onSearchProject">
			</div>
			<!--end::Search-->
		</div>
		<!--begin::Card title-->
	</div>
	<!--end::Card header-->
	<!--begin::Card body-->
	<div class="card-body pt-0">
		<!--begin::Table-->
		<div id="kt_table_users_wrapper" class="dataTables_wrapper dt-bootstrap4 no-footer">
			<div class="table-responsive">
				<table class="table align-middle table-row-dashed fs-6 gy-2 dataTable no-footer">
					<!--begin::Table head-->
					<thead>
						<!--begin::Table row-->
						<tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0 bg-secondary">
							<th class="w-175px pe-2 sorting_disabled ps-1" rowspan="1" colspan="1" aria-label="">
								Name
							</th>
							<th class="w-125px pe-2 sorting_disabled" rowspan="1" colspan="1" aria-label="">
								Owner
							</th>
							<th class="w-125px pe-2 sorting_disabled" rowspan="1" colspan="1" aria-label="">
								Supervisors
							</th>
							<th class="w-125px pe-2 sorting_disabled text-center" rowspan="1" colspan="1" aria-label="">
								Actions
							</th>
						</tr>
						<!--end::Table row-->
					</thead>
					<!--end::Table head-->
					<!--begin::Table body-->
					<tbody class="text-gray-600 fw-bold" id="tbody-archived-projects">	
						
					</tbody>
					<!--end::Table body-->
				</table>
			</div>
		</div>
		<!--end::Table-->
	</div>
	<!--end::Card body-->
</div>