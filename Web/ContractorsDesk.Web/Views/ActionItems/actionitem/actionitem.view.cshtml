
@using ContractorsDesk.WebPortal.Helpers
@Html.RenderSharedComponentStyle("listloader", "listloader.css")
@Html.LoadComponents(new string[]{
	"table", 
	"tabcontrol"
})

<div class="card mb-3 mb-xl-3">
	<div class="card-body pt-9 pb-0 loading">
		@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 7, Header = false, CardBody = false })
		<!--begin::Details-->
		<div class="d-flex flex-wrap flex-sm-nowrap mb-3">
			<!--begin::Image-->
			<div data-model="action-type-icon" 
				class="d-flex flex-column justify-content-center align-items-center flex-shrink-0 bg-info rounded w-100px h-100px w-lg-125px h-lg-125px me-7 mb-4 mt-2">
				
			</div>
			<!--end::Image-->
			<!--begin::Wrapper-->
			<div class="flex-grow-1">
				<!--begin::Head-->
				<div class="d-flex justify-content-between align-items-start flex-wrap">
					<!--begin::Details-->
					<div class="d-flex flex-column">
						<!--begin::Status-->
						<div class="d-flex align-items-center mb-1">
							<a href="javascript:" class="text-gray-800 text-hover-primary fs-2 fw-bolder me-3" data-model="title"></a>
							<span class="badge me-auto" data-model="status">In Progress</span>
						</div>
						<!--end::Status-->
						<!--begin::Description-->
						<div class="d-flex flex-wrap fw-bold mb-4 fs-5 text-gray-400">
							<span class="badge badge-info me-auto" data-model="project"></span>
						</div>
						<!--end::Description-->
					</div>
					<!--end::Details-->
					<!--begin::Actions-->
					<div class="d-flex mb-4">
						<a href="#" class="btn btn-light btn-active-light-primary btn-sm" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
							Actions <i class="fas fa-chevron-down"></i>
						</a>
						<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-200px py-4" data-kt-menu="true" style="">
							<div class="menu-item px-3 d-none" data-status-toggle="not started">
								<a href="javascript:" class="menu-link text-success px-3" evt-click="onStart">
									<span class="svg-icon svg-icon-success svg-icon-1x">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
											<path opacity="0.3" d="M4.05424 15.1982C8.34524 7.76818 13.5782 3.26318 20.9282 2.01418C21.0729 1.98837 21.2216 1.99789 21.3618 2.04193C21.502 2.08597 21.6294 2.16323 21.7333 2.26712C21.8372 2.37101 21.9144 2.49846 21.9585 2.63863C22.0025 2.7788 22.012 2.92754 21.9862 3.07218C20.7372 10.4222 16.2322 15.6552 8.80224 19.9462L4.05424 15.1982ZM3.81924 17.3372L2.63324 20.4482C2.58427 20.5765 2.5735 20.7163 2.6022 20.8507C2.63091 20.9851 2.69788 21.1082 2.79503 21.2054C2.89218 21.3025 3.01536 21.3695 3.14972 21.3982C3.28408 21.4269 3.42387 21.4161 3.55224 21.3672L6.66524 20.1802L3.81924 17.3372ZM16.5002 5.99818C16.2036 5.99818 15.9136 6.08615 15.6669 6.25097C15.4202 6.41579 15.228 6.65006 15.1144 6.92415C15.0009 7.19824 14.9712 7.49984 15.0291 7.79081C15.0869 8.08178 15.2298 8.34906 15.4396 8.55884C15.6494 8.76862 15.9166 8.91148 16.2076 8.96935C16.4986 9.02723 16.8002 8.99753 17.0743 8.884C17.3484 8.77046 17.5826 8.5782 17.7474 8.33153C17.9123 8.08486 18.0002 7.79485 18.0002 7.49818C18.0002 7.10035 17.8422 6.71882 17.5609 6.43752C17.2796 6.15621 16.8981 5.99818 16.5002 5.99818Z" fill="black"></path>
