											<path d="M8.82343 12.0064L8.08852 14.3348C7.8655 15.0414 8.46151 15.7366 9.19388 15.6242L11.8974 15.2092C12.4642 15.1222 12.6916 14.4278 12.2861 14.0223L9.98595 11.7221C9.61452 11.3507 8.98154 11.5055 8.82343 12.0064Z" fill="black" />
										</svg>
									</span>
								</a>
							</div>
							<div class="modal fade" tabindex="-1" id="kt_modal_1">
								<div class="modal-dialog">
									<div class="modal-content">
										<div class="modal-header pb-4 pt-4">
											<h5 class="modal-title">Assign Action Item</h5>
										</div>

										<div class="modal-body">
											<label>Select Supervisor(s):</label>
											<select class="form-select" id="slc-action-item-details-assignedto" multiple></select>
										</div>

										<div class="modal-footer">
											<button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Close</button>
											<button type="button" class="btn btn-sm btn-primary" evt-click="onSaveAssignedTo">
												<span class="indicator-label">Save Changes</span>
												<span class="indicator-progress">
													Please wait...
													<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
												</span>
											</button>
										</div>
									</div>
								</div>
							</div>
							<!--end::Label-->
						</div>
						<!--end::Stat-->
					</div>
					<!--end::Stats-->
				</div>
				<!--end::Info-->
			</div>
			<!--end::Wrapper-->
		</div>
		<!--end::Details-->
		<div class="separator"></div>
	</div>
</div>
<div class="row">
	<div class="col-md-6">
		<div class="card loading">
			@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 15, Header = false, CardBody = false })
			<div class="card-header">
				<!--begin::Card header-->
				<div class="card-title fs-3 fw-bolder">Description</div>
				<div class="card-toolbar d-none" data-toggle-owner="true">
					<a href="javascript:" data-bs-toggle="tooltip" data-bs-original-title="Edit Description" evt-click="onEditDescription">
						<span class="svg-icon svg-icon-muted svg-icon-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<path opacity="0.3" fill-rule="evenodd" clip-rule="evenodd" d="M2 4.63158C2 3.1782 3.1782 2 4.63158 2H13.47C14.0155 2 14.278 2.66919 13.8778 3.04006L12.4556 4.35821C11.9009 4.87228 11.1726 5.15789 10.4163 5.15789H7.1579C6.05333 5.15789 5.15789 6.05333 5.15789 7.1579V16.8421C5.15789 17.9467 6.05333 18.8421 7.1579 18.8421H16.8421C17.9467 18.8421 18.8421 17.9467 18.8421 16.8421V13.7518C18.8421 12.927 19.1817 12.1387 19.7809 11.572L20.9878 10.4308C21.3703 10.0691 22 10.3403 22 10.8668V19.3684C22 20.8218 20.8218 22 19.3684 22H4.63158C3.1782 22 2 20.8218 2 19.3684V4.63158Z" fill="black" />
								<path d="M10.9256 11.1882C10.5351 10.7977 10.5351 10.1645 10.9256 9.77397L18.0669 2.6327C18.8479 1.85165 20.1143 1.85165 20.8953 2.6327L21.3665 3.10391C22.1476 3.88496 22.1476 5.15129 21.3665 5.93234L14.2252 13.0736C13.8347 13.4641 13.2016 13.4641 12.811 13.0736L10.9256 11.1882Z" fill="black" />
								<path d="M8.82343 12.0064L8.08852 14.3348C7.8655 15.0414 8.46151 15.7366 9.19388 15.6242L11.8974 15.2092C12.4642 15.1222 12.6916 14.4278 12.2861 14.0223L9.98595 11.7221C9.61452 11.3507 8.98154 11.5055 8.82343 12.0064Z" fill="black" />
							</svg>
						</span>
					</a>
				</div>
				<!--end::Card header-->
			</div>
			<div class="card-body">
				<!--end::Row-->
				<!--begin::Row-->
				<div class="row mb-8">
					<div class="" data-model="description">
					</div>
					<textarea data-model="description" class="form-control mb-3 d-none" rows="5" style="resize:none;" evt-input="onDescriptionChange"></textarea>
					<div class="d-flex flex-stack justify-content-end d-none" data-toggle-edit="description">
						<button class="btn btn-sm btn-muted" type="button" evt-click="onCancelEditDescription">
							Cancel
						</button>
						<button class="btn btn-sm btn-primary" type="button" data-kt-element="send" evt-click="onSaveDescription">
							<span class="indicator-label">Save</span>
							<span class="indicator-progress">
								Please wait...
								<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
							</span>
						</button>
						<!--end::Send-->
					</div>
				</div>

			</div>
		</div>
	</div>
	<div class="col-md-6">

		<div class="card loading">
			@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 15, Header = false, CardBody = false })
			<div class="card-header">
				<!--begin::Card header-->
				<div class="card-title fs-3 fw-bolder">Comments</div>
				<!--end::Card header-->
			</div>
			<div class="card-body pb-0">
				<div class="row">
					<div class="ps-10" data-model="comments">
						
					</div>
				</div>
			</div>
			<div class="card-footer pt-4" id="kt_chat_messenger_footer">
				<!--begin::Input-->
				<textarea class="form-control mb-3" rows="3" evt-input="onCommentInput" style="resize:none;" data-kt-element="input" placeholder="Type a comment" id="txtComment"></textarea>
				<!--end::Input-->
				<!--begin:Toolbar-->
				<div class="d-flex flex-stack justify-content-end">
					<!--begin::Send-->
					<button class="btn btn-sm btn-primary" type="button" disabled data-kt-element="send" evt-click="onAddComment">
						<span class="indicator-label">Post Comment</span>
						<span class="indicator-progress">
							Please wait...
							<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
						</span>
					</button>
					<!--end::Send-->
				</div>
				<!--end::Toolbar-->
			</div>
		</div>
	</div>
</div>
