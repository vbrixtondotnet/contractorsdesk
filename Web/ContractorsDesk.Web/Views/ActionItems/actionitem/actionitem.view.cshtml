										</svg>
									</span>
									Start
								</a>
							</div>
							<div class="menu-item px-3 d-none" data-status-toggle="in progress">
								<a href="javascript:" class="menu-link text-primary px-3" evt-click="onComplete">
									<span class="svg-icon svg-icon-primary svg-icon-1x">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
											<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="black"></rect>
											<path d="M10.4343 12.4343L8.75 10.75C8.33579 10.3358 7.66421 10.3358 7.25 10.75C6.83579 11.1642 6.83579 11.8358 7.25 12.25L10.2929 15.2929C10.6834 15.6834 11.3166 15.6834 11.7071 15.2929L17.25 9.75C17.6642 9.33579 17.6642 8.66421 17.25 8.25C16.8358 7.83579 16.1642 7.83579 15.75 8.25L11.5657 12.4343C11.2533 12.7467 10.7467 12.7467 10.4343 12.4343Z" fill="black"></path>
										</svg>
									</span>
									Complete
								</a>
							</div>
							<div class="menu-item px-3">
								<a href="javascript:" class="menu-link px-3" evt-click="onArchive">
									<span class="svg-icon svg-icon-muted svg-icon-1x">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
											<rect opacity="0.3" width="12" height="2" rx="1" transform="matrix(-1 0 0 1 15.5 11)" fill="black"></rect>
											<path d="M13.6313 11.6927L11.8756 10.2297C11.4054 9.83785 11.3732 9.12683 11.806 8.69401C12.1957 8.3043 12.8216 8.28591 13.2336 8.65206L16.1592 11.2526C16.6067 11.6504 16.6067 12.3496 16.1592 12.7474L13.2336 15.3479C12.8216 15.7141 12.1957 15.6957 11.806 15.306C11.3732 14.8732 11.4054 14.1621 11.8756 13.7703L13.6313 12.3073C13.8232 12.1474 13.8232 11.8526 13.6313 11.6927Z" fill="black"></path>
											<path d="M8 5V6C8 6.55228 8.44772 7 9 7C9.55228 7 10 6.55228 10 6C10 5.44772 10.4477 5 11 5H18C18.5523 5 19 5.44772 19 6V18C19 18.5523 18.5523 19 18 19H11C10.4477 19 10 18.5523 10 18C10 17.4477 9.55228 17 9 17C8.44772 17 8 17.4477 8 18V19C8 20.1046 8.89543 21 10 21H19C20.1046 21 21 20.1046 21 19V5C21 3.89543 20.1046 3 19 3H10C8.89543 3 8 3.89543 8 5Z" fill="#C4C4C4"></path>
										</svg>
									</span>
									Archive
								</a>
							</div>
						</div>
					</div>
					<!--end::Actions-->
				</div>
				<!--end::Head-->
				<!--begin::Info-->
				<div class="d-flex flex-wrap justify-content-start" style="margin-top:-3px;">
					<!--begin::Stats-->
					<div class="d-flex flex-wrap">
						<!--begin::Stat-->
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3 d-flex flex-column justify-content-center">
							<!--begin::Number-->
							<div class="fs-4 fw-bolder text-center mt-2" data-model="duedate"></div>
							<!--end::Number-->
							<!--begin::Label-->
							<div class="fw-bold fs-6 text-gray-400 text-center mt-5">Due Date</div>
							<!--end::Label-->
						</div>
						<!--end::Stat-->
						<!--begin::Stat-->
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<!--begin::Number-->
							<div class="d-flex align-items-center justify-content-center">
								<div class="symbol-group symbol-hover mb-3">
									<!--begin::User-->
									<div class="symbol symbol-35px symbol-circle" data-model="createdBy">
										<span class="symbol-label bg-warning text-inverse-warning fw-bolder" data-model="createdByInitials"></span>
									</div>
								</div>
							</div>
							<!--end::Number-->
							<!--begin::Label-->
							<div class="fw-bold fs-6 text-gray-400 text-center">Created By</div>
							<!--end::Label-->
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<!--begin::Number-->
							<div class="d-flex align-items-center justify-content-center">
								<div class="symbol-group symbol-hover mb-3" data-model="assignedto">
									
								</div>
							</div>
							<!--end::Number-->
							<!--begin::Label-->
							<div class="fw-bold fs-6 text-gray-400 text-center">
								Assigned To
								<a href="javascript:" 
									class="d-none"
									data-bs-toggle="tooltip" 
									data-bs-original-title="Edit Assigned To" 
									evt-click="onEditAssignedTo"
								    data-toggle-owner="true">
									<span class="svg-icon svg-icon-muted svg-icon-2">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
											<path opacity="0.3" fill-rule="evenodd" clip-rule="evenodd" d="M2 4.63158C2 3.1782 3.1782 2 4.63158 2H13.47C14.0155 2 14.278 2.66919 13.8778 3.04006L12.4556 4.35821C11.9009 4.87228 11.1726 5.15789 10.4163 5.15789H7.1579C6.05333 5.15789 5.15789 6.05333 5.15789 7.1579V16.8421C5.15789 17.9467 6.05333 18.8421 7.1579 18.8421H16.8421C17.9467 18.8421 18.8421 17.9467 18.8421 16.8421V13.7518C18.8421 12.927 19.1817 12.1387 19.7809 11.572L20.9878 10.4308C21.3703 10.0691 22 10.3403 22 10.8668V19.3684C22 20.8218 20.8218 22 19.3684 22H4.63158C3.1782 22 2 20.8218 2 19.3684V4.63158Z" fill="black" />
