<div id="scroll-action-bar" class="action-menu-bar notice bg-light-primary rounded border-primary border border-dashed  sticky-action-bar">
    <div style="display: flex; gap: 5px;">
        <button type="button" class="btn btn-sm btn-bg-secondary text-inverse-secondary me-1 w-150px"
                onmouseover="this.style.transform='scale(1.1)'"
                onmouseout="this.style.transform='scale(1)'"
                style="transition: transform 0.3s ease;" evt-click="print" id="btnPrint">
            <span class="indicator-label">Print</span>
            <span class="indicator-progress">
                Please wait...
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        </button>
    </div>
</div>