@using ContractorsDesk.WebPortal.Helpers;
@{
	var Tab = ViewBag.Tab as string;
	Tab = string.IsNullOrEmpty(Tab) ? "action-items" : Tab;
}
<div class="col-md-12 tabcontrol-item mt-3" id="tab-schedule">
	<div id="dv-tab-schedule" class="loading">
		@await Html.PartialAsync("Components/listloader/listloader", new { LinesCount = 15, Header = false, CardBody = false })

		<div class="card card-flush h-lg-100 p-0" id="schedule-body">
			<!--begin::Card header-->
			<div class="card-header justify-content-end schedule-content ribbon ribbon-start ribbon-clip">
				<div class="ribbon-label bg-secondary text-dark fs-4" data-status-toggle="Draft">
					DRAFT
					<span class="ribbon-inner"></span>
				</div>
				<div class="ribbon-label bg-success fs-4" data-status-toggle="Final">
					FINAL
					<span class="ribbon-inner"></span>
				</div>
				<div class="card-title">
					<div class="justify-self-right">
						<button type="button" class="btn btn-sm btn-bg-secondary text-inverse-secondary me-1" evt-click="printSchedule" id="btnPrint">
							<span class="indicator-label">
								<i class="bi bi-printer me-1"></i>
								Print
							</span>
							<span class="indicator-progress">
								Please wait...
								<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
							</span>
						</button>
					</div>
				</div>
				
			</div>

			<div class="card-body pt-0  schedule-content" id="schedule-details">
				<div class="table-responsive">
					<table class="table table-cell-bordered schedule-table">
						<thead class="sticky-header-schedule">
							<tr class="fw-bolder fs-6 text-gray-800 bg-light border-3">
								<th class="ps-2 w-75px text-center">Seq</th>
								<th class="text-center min-w-250px mw-250px">Name</th>
								<th class="text-center w-50px">Duration</th>
								<th class="text-center min-w-125px">Start Date</th>
								<th class="text-center min-w-125px">End Date</th>
								<th class="text-center min-w-250px mw-150px">Predecessor</th>
								<th class="text-center w-50px">Lag</th>
							</tr>
						</thead>
						<tbody id="schedule-details-body">
						</tbody>
					</table>
				</div>
			</div>
			<!--end::Card body-->
		</div>
		<div class="card card-flush h-lg-100 p-0 d-none" id="empty-schedule-body">
			
			<div class="card-body pt-5">
				<div class="alert bg-light-danger border border-danger border-dashed d-flex flex-column flex-sm-row w-100 p-5 ">
					<span class="svg-icon svg-icon-2hx svg-icon-danger me-4 mb-5 mb-sm-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
							<path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="black"></path>
							<rect x="9" y="13.0283" width="7.3536" height="1.2256" rx="0.6128" transform="rotate(-45 9 13.0283)" fill="black"></rect>
							<rect x="9.86664" y="7.93359" width="7.3536" height="1.2256" rx="0.6128" transform="rotate(45 9.86664 7.93359)" fill="black"></rect>
						</svg>
					</span>
					<div class="d-flex flex-column pe-0 pe-sm-10">
						<h5 class="mb-1">Project Schedule Not Available!</h5>
						<span class="text-dark">There is no schedule set for this project yet. Please contact your account supervisor.</span>
					</div>
				</div>
			</div>
			<!--end::Card body-->
		</div>
	</div>
</div>
@await Html.PartialAsync("action-menu-bar.cshtml")